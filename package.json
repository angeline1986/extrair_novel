{
  "type": "module",
  "name": "extrair_novel",
  "version": "2.1.0",
  "description": "Extração de DOCX e geração de EPUBs organizados com suporte a traduções, auditoria e versionamento incremental.",
  "main": "src/cli.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/angeline1986/extrair_novel.git"
  },
  "scripts": {
    "start": "node src/cli.js",
    
    "translate:one": "node workflows/translate-docx/scripts/translateOne.js",
    "translate:folder": "node workflows/translate-docx/scripts/translateFolder.js",
    "translate:sequential": "node workflows/translate-docx/scripts/translateSequential.js",
    
    "extract:epub": "node workflows/epub-to-docx/scripts/extractEpubInChapterGroups.cjs",
    "extract:epub:groups": "node workflows/epub-to-docx/scripts/extractEpubInChapterGroups.cjs",
    
    "build:epub": "node workflows/docx-to-epub/scripts/buildEpubFromDocx.js",
    
    "analyze:translation": "node workflows/review-translation/scripts/analyzeTranslation.js",
    
    "audit:translation": "node workflows/audit-translation-docx/src/audit.js",
    "audit:translation:verbose": "node workflows/audit-translation-docx/src/audit.js --verbose",
    
    "fix:gender": "node workflows/audit-translation-docx/src/fix-gender-issues.js",
    "fix:gender:verbose": "node workflows/audit-translation-docx/src/fix-gender-issues.js --verbose",
    "fix:gender:step": "node workflows/audit-translation-docx/src/fix-gender-issues.js --step",
    
    "audit:menu": "node workflows/audit-translation-docx/src/menu.js",
    
    "version:status": "node workflows/audit-translation-docx/src/version-cli.js status",
    "version:current": "node workflows/audit-translation-docx/src/version-cli.js current",
    "version:list": "node workflows/audit-translation-docx/src/version-cli.js list",
    "version:next": "node workflows/audit-translation-docx/src/version-cli.js next",
    "version:prev": "node workflows/audit-translation-docx/src/version-cli.js prev",
    "version:goto": "node workflows/audit-translation-docx/src/version-cli.js goto",
    "version:diff": "node workflows/audit-translation-docx/src/version-cli.js diff",
    "version:clean": "node workflows/audit-translation-docx/src/version-cli.js clean",
    "version:create": "node workflows/audit-translation-docx/src/version-cli.js create",
    "version:help": "node workflows/audit-translation-docx/src/version-cli.js help",
    
    "test": "echo \"No tests configured\""
  },
  "keywords": [
    "docx",
    "epub",
    "converter",
    "traducao",
    "ebook",
    "cli",
    "auditoria",
    "versionamento"
  ],
  "author": "Aline Souza <angeline.fm@gmail.com> (https://github.com/angeline1986)",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "cheerio": "^1.2.0",
    "docx": "^9.6.1",
    "mammoth": "^1.12.0",
    "puppeteer": "^24.42.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=7.0.0"
  }
}